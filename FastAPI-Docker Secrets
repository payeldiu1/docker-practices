# without encryption
def read_secret_no_enc(name, default=None):
    path = f"/run/secrets/{name}"
    if os.path.exists(path):
        with open(path, "r") as f:
            return f.read().strip()
    return os.getenv(name.upper(), default)

USERNAME = read_secret("username")
