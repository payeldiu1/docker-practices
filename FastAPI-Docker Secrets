class ReplyRequest(BaseModel):
    id: str
    changekey: str
    body: str

@app.post("/emails/reply")
def reply_email(payload: ReplyRequest):
    try:
        account = get_account()

        original_message = account.inbox.get(
            id=payload.id.strip(),
            changekey=payload.changekey.strip()
        )

        original_message.reply(
            subject=f"RE: {original_message.subject}",
            body=payload.body,
            to_recipients=[original_message.sender.email_address]
        )

        return {"status": "success"}

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

# ================================
# ✅ Mark as read
# ================================

class MarkReadRequest(BaseModel):
    id: str
    changekey: str

@app.post("/emails/mark-read")
def mark_as_read(payload: MarkReadRequest):
    try:
        account = get_account()

        item = account.inbox.get(
            id=payload.id,
            changekey=payload.changekey
        )

        item.is_read = True
        item.save(update_fields=["is_read"])

        return {"status": "success"}

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


