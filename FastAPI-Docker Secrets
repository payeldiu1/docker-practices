@app.get("/emails/recent")
def get_recent(hours: int = 24):
    try:
        account = get_account()
        since = datetime.now() - timedelta(hours=hours)

        emails = []
        for item in account.inbox.filter(datetime_received__gte=since):
            emails.append({
                "subject": item.subject,
                "from": item.sender.email_address if item.sender else None,
                "received": item.datetime_received
            })

        return {"count": len(emails), "data": emails}

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

# ================================
# 🔍 Unread search
# ================================

@app.get("/emails/unread_search")
def get_unread_search(
    keywords: str = Query(None),
    mode: str = Query("or"),
    limit: int = 1
):
    try:
        account = get_account()

        keyword_list = []
        if keywords:
            keyword_list = [k.strip().lower() for k in keywords.split(",") if k.strip()]

        emails = []

        if keyword_list and mode.lower() == "and":
            query = account.inbox.filter(is_read=False)

            for word in keyword_list:
                query = query.filter(subject__icontains=word)

            items = query.order_by('-datetime_received')[:limit]

        else:
            items = account.inbox.filter(is_read=False).order_by('-datetime_received')[:limit * 50]

        for item in items:
            subject = (item.subject or "").lower()

            if not keyword_list:
                match = True
            elif mode.lower() == "or":
                match = any(k in subject for k in keyword_list)
            else:
                match = all(k in subject for k in keyword_list)

            if match:
                emails.append({
                    "id": item.id,
                    "subject": item.subject,
                    "from": item.sender.email_address if item.sender else None,
                    "received": item.datetime_received,
                    "changekey": item.changekey,
                    "body": item.text_body or item.body or ""
                })

            if len(emails) >= limit:
                break

        return {
            "mode": mode,
            "keywords": keyword_list,
            "count": len(emails),
            "data": emails
        }

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

