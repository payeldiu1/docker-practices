# ✅ Get latest emails
@app.get("/emails")
def get_emails(limit: int = 10):
    try:
        account = get_account()
        emails = []

        for item in account.inbox.all().order_by('-datetime_received')[:limit]:
            emails.append({
                "subject": item.subject,
                "from": item.sender.email_address if item.sender else None,
                "received": item.datetime_received,
                "body": str(item.text_body)[:500] if item.text_body else None
            })

        return {"count": len(emails), "data": emails}

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


