# ✅ Get emails from last N hours
@app.get("/emails/recent")
def get_recent(hours: int = 24):
    try:
        account = get_account()
        since = datetime.now() - timedelta(hours=hours)

        emails = []
        for item in account.inbox.filter(datetime_received__gte=since):
            emails.append({
                "subject": item.subject,
                "from": item.sender.email_address if item.sender else None,
                "received": item.datetime_received
            })

        return {"count": len(emails), "data": emails}

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


#✅ multiple keyword search (like Gmail)
# mode or GET /emails/unread?keywords=transfer,posting,liability
#mode and GET /emails/unread?keywords=transfer,posting&mode=and
@app.get("/emails/unread_search")
def get_unread(
    keywords: str = Query(None, description="Comma-separated keywords"),
    mode: str = Query("or", description="Search mode: and/or"),
    limit: int = 50
):
    try:
        account = get_account()

        # Normalize keywords
        keyword_list = []
        if keywords:
            keyword_list = [k.strip().lower() for k in keywords.split(",") if k.strip()]

        emails = []

        # ✅ AND mode → server-side filtering (FAST)
        if keyword_list and mode.lower() == "and":
            query = account.inbox.filter(is_read=False)

            for word in keyword_list:
                query = query.filter(subject__icontains=word)

            items = query.order_by('-datetime_received')[:limit]

            for item in items:
                emails.append({
                    "id": item.id,  # 🔑 Unique message ID
                    "subject": item.subject,
                    "from": item.sender.email_address if item.sender else None,
                    "received": item.datetime_received,
                    "changekey": item.changekey,
                    "body": item.text_body or item.body or ""  # 📩 Plain text body fallback
                })

        # ✅ OR mode → client-side filtering (FLEXIBLE)
        else:
            items = account.inbox.filter(is_read=False).order_by('-datetime_received')[:limit * 2]

            for item in items:
                subject = (item.subject or "").lower()

                if not keyword_list:
                    match = True
                elif mode.lower() == "or":
                    match = any(k in subject for k in keyword_list)
                else:
                    match = all(k in subject for k in keyword_list)

                if match:
                    emails.append({
                        "id": item.id,  # 🔑 Unique message ID
                        "subject": item.subject,
                        "from": item.sender.email_address if item.sender else None,
                        "received": item.datetime_received,
                        "body": item.text_body or item.body or ""  # 📩 Plain text body fallback
                    })

                if len(emails) >= limit:
                    break

        return {
            "mode": mode,
            "keywords": keyword_list,
            "count": len(emails),
            "data": emails
        }

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))



#✅ Email Reply API by message id and change key

""" sample request
{
  "id": "AAMkAGI2...AAA=",
  "changekey": "CQAAABYAA...",
  "body": "Thank you for your email. We are checking the matter."
}"""

from fastapi import HTTPException
from pydantic import BaseModel
from exchangelib.items import Message
from exchangelib.properties import ItemId


class ReplyRequest(BaseModel):
    id: str
    changekey: str
    body: str


@app.post("/emails/reply")
def reply_email(payload: ReplyRequest):
    try:
        account = get_account()

        # Bind original message
        original_message = Message.bind(
            account=account,
            item_id=ItemId(
                id=payload.id,
                changekey=payload.changekey
            )
        )

        # Create reply
        reply = original_message.create_reply()

        # Set reply body
        reply.body = payload.body

        # Send reply
        reply.send_and_save_copy()

        return {
            "status": "success",
            "message": "Reply sent successfully"
        }

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


# # ✅ Mark email as read (by message id:chnage key)
# sample input GET http://localhost:8000/emails/mark-read/AAMkAGI2...AAA=:CQAAABYAA


@app.get("/emails/mark-read/{message_id}")
def mark_as_read(message_id: str):
    try:
        account = get_account()

        # Expected format:
        # message_id = "ITEMID:CHANGEKEY"

        if ":" not in message_id:
            raise HTTPException(
                status_code=400,
                detail="message_id must contain id:changekey"
            )

        item_id, change_key = message_id.split(":", 1)

        # Bind message properly
        item = Message.bind(
            account=account,
            item_id=ItemId(id=item_id, changekey=change_key)
        )

        # Mark as read
        item.is_read = True
        item.save(update_fields=["is_read"])

        return {
            "status": "success",
            "message": "Email marked as read"
        }

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))





