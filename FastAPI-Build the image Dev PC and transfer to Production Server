from fastapi import FastAPI, HTTPException
from exchangelib import Credentials, Account, Configuration, DELEGATE
from exchangelib.protocol import BaseProtocol, NoVerifyHTTPAdapter
from datetime import datetime, timedelta

# ⚠️ Disable SSL verification (only for internal/self-signed certs)
BaseProtocol.HTTP_ADAPTER_CLS = NoVerifyHTTPAdapter

app = FastAPI(title="Exchange Email API")

# 🔐 Config (move to .env in production)
USERNAME = "your_username"
PASSWORD = "your_password"
EMAIL = "user@yourdomain.com"
EWS_URL = "https://your-exchange-server/EWS/Exchange.asmx"


def get_account():
    credentials = Credentials(username=USERNAME, password=PASSWORD)
    config = Configuration(service_endpoint=EWS_URL, credentials=credentials)

    account = Account(
        primary_smtp_address=EMAIL,
        config=config,
        autodiscover=False,
        access_type=DELEGATE
    )
    return account


# ✅ Health check
@app.get("/")
def health():
    return {"status": "Exchange API is running"}


# ✅ Get latest emails
@app.get("/emails")
def get_emails(limit: int = 10):
    try:
        account = get_account()
        emails = []

        for item in account.inbox.all().order_by('-datetime_received')[:limit]:
            emails.append({
                "subject": item.subject,
                "from": item.sender.email_address if item.sender else None,
                "received": item.datetime_received,
                "body": str(item.text_body)[:500] if item.text_body else None
            })

        return {"count": len(emails), "data": emails}

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


# ✅ Get unread emails
@app.get("/emails/unread")
def get_unread():
    try:
        account = get_account()
        emails = []

        for item in account.inbox.filter(is_read=False):
            emails.append({
                "subject": item.subject,
                "from": item.sender.email_address if item.sender else None,
                "received": item.datetime_received
            })

        return {"count": len(emails), "data": emails}

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


# ✅ Get emails from last N hours
@app.get("/emails/recent")
def get_recent(hours: int = 24):
    try:
        account = get_account()
        since = datetime.now() - timedelta(hours=hours)

        emails = []
        for item in account.inbox.filter(datetime_received__gte=since):
            emails.append({
                "subject": item.subject,
                "from": item.sender.email_address if item.sender else None,
                "received": item.datetime_received
            })

        return {"count": len(emails), "data": emails}

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

#✅ multiple keyword search (like Gmail)
# mode or GET /emails/unread?keywords=transfer,posting,liability
#mode and GET /emails/unread?keywords=transfer,posting&mode=and
@app.get("/emails/unread_search")
def get_unread(
    keywords: str = Query(None, description="Comma-separated keywords"),
    mode: str = Query("or", description="Search mode: and/or"),
    limit: int = 50
):
    try:
        account = get_account()

        # Normalize keywords
        keyword_list = []
        if keywords:
            keyword_list = [k.strip().lower() for k in keywords.split(",") if k.strip()]

        emails = []

        # ✅ AND mode → server-side filtering (FAST)
        if keyword_list and mode.lower() == "and":
            query = account.inbox.filter(is_read=False)

            for word in keyword_list:
                query = query.filter(subject__icontains=word)

            items = query.order_by('-datetime_received')[:limit]

            for item in items:
                emails.append({
                    "subject": item.subject,
                    "from": item.sender.email_address if item.sender else None,
                    "received": item.datetime_received
                })

        # ✅ OR mode → client-side filtering (FLEXIBLE)
        else:
            items = account.inbox.filter(is_read=False).order_by('-datetime_received')[:limit * 2]

            for item in items:
                subject = (item.subject or "").lower()

                if not keyword_list:
                    match = True
                elif mode.lower() == "or":
                    match = any(k in subject for k in keyword_list)
                else:
                    match = all(k in subject for k in keyword_list)

                if match:
                    emails.append({
                        "subject": item.subject,
                        "from": item.sender.email_address if item.sender else None,
                        "received": item.datetime_received
                    })

                if len(emails) >= limit:
                    break

        return {
            "mode": mode,
            "keywords": keyword_list,
            "count": len(emails),
            "data": emails
        }

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


# ✅ Mark email as read (by subject match - simple example)
@app.post("/emails/mark-read")
def mark_as_read(subject: str):
    try:
        account = get_account()

        items = account.inbox.filter(subject=subject, is_read=False)
        count = 0

        for item in items:
            item.is_read = True
            item.save()
            count += 1

        return {"message": f"{count} emails marked as read"}

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


